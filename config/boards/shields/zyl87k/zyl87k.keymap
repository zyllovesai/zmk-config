
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        rgb_bri_enc: rgb_bri_enc {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        //rgb_hue_enc: rgb_hue_enc {
            //compatible = "zmk,behavior-sensor-rotate";
            //#sensor-binding-cells = <0>;
            //bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;
        //};
    };

    
    keymap0: keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC               &kp F1    &kp F2    &kp F3     &kp F4          &kp F5     &kp F6     &kp F7    &kp F8    &kp F9    &kp F10    &kp F11    &kp F12   &kp PRINTSCREEN    &kp SCROLLLOCK   &kp PAUSE_BREAK 
&kp GRAVE   &kp N1    &kp N2    &kp N3    &kp N4     &kp N5  &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS  &kp EQUAL &kp BACKSPACE    &kp INSERT  &kp HOME  &kp PAGE_UP
&kp TAB     &kp Q     &kp W     &kp E     &kp R      &kp T   &kp Y   &kp U      &kp I      &kp O     &kp P     &kp LEFT_BRACKET   &kp RIGHT_BRACKET    &kp BACKSLASH     &kp DELETE    &kp END    &kp PAGE_DOWN
&kp CAPS    &kp A     &kp S     &kp D     &kp F      &kp G   &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp APOS        &kp ENTER   
&kp LSHFT   &kp Z     &kp X     &kp C     &kp V      &kp B   &kp N   &kp M      &kp COMMA  &kp DOT   &kp SLASH                   &kp RSHIFT                  &kp UP 
&kp LCTRL   &kp LWIN  &kp LALT                     &kp SPACE                               &kp RALT  &kp RWIN     &mo 1    &kp RCTRL          &kp LEFT  &kp DOWN  &kp RIGHT 
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };
            fn1_layer {
            bindings = <
&kp ESC               &kp F1    &kp F2    &kp F3     &kp F4          &kp F5     &kp F6     &kp F7    &kp F8    &kp F9    &kp F10    &kp F11    &kp F12  &kp PRINTSCREEN    &kp SCROLLLOCK   &kp PAUSE_BREAK 
&kp GRAVE   &kp N1    &kp N2    &kp N3    &kp N4     &kp N5  &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS  &kp EQUAL &kp BACKSPACE    &kp INSERT  &bootloader  &kp PAGE_UP
&kp TAB     &kp Q     &kp W     &kp E     &kp R      &kp T   &kp Y   &kp U      &kp I      &kp O     &kp P     &kp LEFT_BRACKET   &kp RIGHT_BRACKET    &kp BACKSLASH     &bt BT_CLR_ALL    &kp END    &kp PAGE_DOWN
&kp CAPS    &kp A     &kp S     &kp D     &kp F      &kp G   &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp APOS        &kp ENTER   
&kp LSHFT   &kp Z     &kp X     &kp C     &kp V      &kp B   &kp N   &kp M      &kp COMMA  &kp DOT   &kp SLASH                   &kp RSHIFT                  &kp UP 
&kp LCTRL   &kp LWIN  &kp LALT                     &kp SPACE                               &kp RALT  &kp RWIN     &none    &kp RCTRL          &kp LEFT  &kp DOWN  &kp RIGHT 
            >;
            sensor-bindings = <&rgb_bri_enc>;  // 基础层：调亮度
        };
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap0: keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3  &kp N4     &kp N5  &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp BSPC
&kp TAB    &kp Q     &kp W     &kp E   &kp R      &kp T   &kp Y   &kp U      &kp I      &kp O     &kp P     &mo 2
&kp CAPS   &kp A     &kp S     &kp D   &kp F      &kp G   &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z     &kp X     &kp C   &kp V      &kp B   &kp N   &kp M      &kp COMMA  &kp DOT   &kp UP    &kp MINUS
&kp LCTRL  &kp LWIN  &kp LALT  &mo 1   &kp SPACE                  &kp ENTER  &mo 1      &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        fn1_layer {
            bindings = <
&kp TILDE       &kp QUESTION  &none         &none                 &none                  &none                     &none      &none         &none         &none         &none            &kp DEL
&none           &none         &none         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none                     &none      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none            &none
&none           &none         &none         &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BSLH                  &kp SLASH  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MULTIPLY  &kp KP_DIVIDE
&kp LEFT_SHIFT  &none         &none         &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp KP_RIGHT_PARENTHESIS  &none      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PG_UP        &kp KP_PLUS
&kp LCTRL       &none         &kp LEFT_ALT  &none                 &kp HOME                                                    &kp NUMBER_0  &kp KP_DOT    &none         &kp PG_DN        &kp EQUAL
            >;
        };

        fn2_layer {
            bindings = <
&kp LA(F4)      &kp F1       &kp F2  &kp F3  &kp F4        &kp F5  &kp F6  &kp F7        &kp F8  &kp F9   &kp F10         &kp LC(LA(DEL))
&none           &none        &none   &none   &none         &none   &none   &none         &none   &kp F11  &kp F12         &none
&none           &none        &none   &none   &none         &none   &none   &none         &none   &none    &none           &none
&none           &none        &none   &none   &none         &none   &none   &none         &none   &none    &kp C_VOL_UP    &none
&bt BT_CLR_ALL  &bootloader  &none   &none   &none                         &none         &none   &none    &kp C_VOL_DN    &kp C_MUTE
            >;
        };
    };
};
